{
  "name": "sheet-music-mcp-ui",
  "private": true,
  "type": "module",
  "description": "MCP Apps UI workspace: shared kit and single-file app pages for the sheet-music MCP servers.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && node scripts/check-html.mjs dist/score-viewer.html",
    "test": "vitest run",
    "test:e2e": "npm run build:host && playwright test",
    "typecheck": "tsc --noEmit",
    "copy-assets": "node scripts/copy-assets.mjs",
    "measure": "npm run build:host && node scripts/measure.mjs",
    "build:host": "vite build --config test/mock-host/vite.config.ts",
    "perf": "npm run build:host && node scripts/perf.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
