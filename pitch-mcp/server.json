{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.raulkivi/pitch-mcp",
  "title": "Singing Pitch Tracker",
  "description": "Real-time pitch detection and score alignment for a singer, from microphone input",
  "repository": {
    "url": "https://github.com/raulkivi/sheet-music-mcp",
    "source": "github",
    "subfolder": "pitch-mcp"
  },
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "pitch-mcp",
      "version": "0.3.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PITCH_BACKEND",
          "description": "Pitch detection algorithm: librosa (default) or crepe",
          "isRequired": false,
          "isSecret": false,
          "default": "librosa",
          "choices": [
            "librosa",
            "crepe"
          ]
        }
      ]
    }
  ]
}
